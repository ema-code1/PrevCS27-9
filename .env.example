#--------------------------------------------------------------------
# PrevCS · plantilla del .env
#--------------------------------------------------------------------
# setup.cmd (o `php spark prevcs:setup`) copia este archivo a .env si no
# existe. Los valores de abajo funcionan con un XAMPP recién instalado.
# El .env real NO va al repo: ahí van las claves.

#--------------------------------------------------------------------
# Entorno y URL
#--------------------------------------------------------------------
CI_ENVIRONMENT = development

# Carpeta del proyecto dentro de C:\xampp\htdocs, terminada en /public/
app.baseURL = 'http://localhost/PreventiveControlSystem/public/'

#--------------------------------------------------------------------
# Base de datos (MySQL de XAMPP)
#--------------------------------------------------------------------
# La base se crea sola con setup.cmd si no existe.
database.default.hostname = localhost
database.default.database = prevcs
database.default.username = root
database.default.password =
database.default.DBDriver = MySQLi

#--------------------------------------------------------------------
# Correo (verificación de cuenta, recuperar contraseña, invitaciones)
#--------------------------------------------------------------------
# Con Gmail: SMTPUser = tu cuenta, SMTPPass = una "contraseña de aplicación"
# (https://myaccount.google.com/apppasswords), no la contraseña normal.
email.protocol = smtp
email.SMTPHost = smtp.gmail.com
email.SMTPPort = 587
email.SMTPCrypto = tls
email.SMTPUser =
email.SMTPPass =
email.fromEmail =
email.fromName = "PrevCS Team"
email.mailType = html
email.charset = utf-8
email.wordWrap = true

#--------------------------------------------------------------------
# Mercado Pago · Suscripción PrevCS Pro
#--------------------------------------------------------------------
# Credenciales: https://www.mercadopago.com.ar/developers/panel/app
#   → tu aplicación → Credenciales → pestaña "Prueba" (para testear)
#   → pestaña "Producción" solo cuando salgas en vivo (cobros reales).
#
# Pasar a producción:
#   1. Reemplazá MP_ACCESS_TOKEN y MP_PUBLIC_KEY por las de Producción.
#   2. Vaciá MP_SUBSCRIPTION_PLAN_ID y corré `php spark mp:plan` (el plan
#      pertenece a la cuenta: el de prueba no existe en la real).
#   3. Poné en APP_URL la URL pública HTTPS del sitio.

# Servidor · secreto: nunca lo compartas ni lo subas a Git.
MP_ACCESS_TOKEN=
# Navegador · público.
MP_PUBLIC_KEY=

# Lo completa `php spark mp:plan` la primera vez.
MP_SUBSCRIPTION_PLAN_ID=

# Precio del plan. Para cambiarlo: editá el monto y corré `php spark mp:plan`.
MP_PLAN_AMOUNT=1000
MP_PLAN_CURRENCY=ARS

# Panel de Mercado Pago → Webhooks → Guardar → clave secreta.
# URL del webhook: <APP_URL>/api/webhooks/mercadopago
MP_WEBHOOK_SECRET=

# URL base pública del sitio (back_url del plan y webhooks).
APP_URL=http://localhost/PreventiveControlSystem/public

# Túnel ngrok (ver tunel.cmd): con este host el sitio arma sus links en https://<host>.
# Con el túnel activo, APP_URL también debería ser https://<host>/PreventiveControlSystem/public
app.tunnelHost=
