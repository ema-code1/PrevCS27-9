#--------------------------------------------------------------------
# .env.example — PLANTILLA. Copiá este archivo como `.env` y completá
# los valores. El `.env` real NO se sube al repo (está en .gitignore).
#--------------------------------------------------------------------

#--------------------------------------------------------------------
# ENVIRONMENT
#--------------------------------------------------------------------

CI_ENVIRONMENT = development

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------

app.baseURL = 'http://localhost/PreventiveControlSystem/public/'
app_baseURL = 'http://localhost/PreventiveControlSystem/public/'

#--------------------------------------------------------------------
# DATABASE  (valores por defecto de XAMPP)
#--------------------------------------------------------------------

database.default.hostname = localhost
database.default.database = prevcs
database.default.username = root
database.default.password =
database.default.DBDriver = MySQLi
# database.default.port = 3306

#--------------------------------------------------------------------
# EMAIL (SMTP) — completá con tus credenciales, NO las subas al repo
#--------------------------------------------------------------------

email.protocol = smtp
email.SMTPHost = smtp.gmail.com
email.SMTPPort = 587
email.SMTPCrypto = tls
email.SMTPUser = preventivecontrolsystem.saas@gmail.com
email.SMTPPass = hxaqibembsynuuno
email.fromEmail = preventivecontrolsystem.saas@gmail.com
email.fromName = "PrevCS Team"
email.mailType = html
email.charset = utf-8
email.wordWrap = true
